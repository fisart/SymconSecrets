{
  "elements": [
    {
      "type": "Label",
      "caption": "Separate Secrets Backend \u2014 development only; does not read or change the old vault. Requires PHP 8.2+, sodium, OpenSSL, curl, PDO SQLite and SQLite 3.51.3+ for WAL."
    },
    {
      "type": "CheckBox",
      "name": "Enabled",
      "caption": "Enable backend after independent anchor provisioning"
    },
    {
      "type": "CheckBox",
      "name": "DebugEnabled",
      "caption": "Sanitized Debug variable below the instance"
    },
    {
      "type": "SelectInstance",
      "name": "FrontendInstanceID",
      "caption": "Paired SecretsFrontend",
      "validModules": [
        "{8D6AE8F7-EA3A-4513-AA14-C3F9613B0E83}"
      ]
    },
    {
      "type": "ValidationTextBox",
      "name": "DataDirectory",
      "caption": "Vault database directory (absolute, private, new directory)"
    },
    {
      "type": "ValidationTextBox",
      "name": "KeyDirectory",
      "caption": "Separate key directory (absolute, private, new directory)"
    },
    {
      "type": "ValidationTextBox",
      "name": "AdminOrigin",
      "caption": "Exact administrator HTTPS origin"
    },
    {
      "type": "ValidationTextBox",
      "name": "AnchorURL",
      "caption": "Independent anchor HTTPS URL ending /v1/anchor"
    },
    {
      "type": "ValidationTextBox",
      "name": "AnchorPublicKey",
      "caption": "Pinned anchor Ed25519 public key (base64url)"
    },
    {
      "type": "ValidationTextBox",
      "name": "AnchorKeyID",
      "caption": "Pinned anchor key ID (base64url)"
    },
    {
      "type": "ValidationTextBox",
      "name": "ClientCertificatePath",
      "caption": "Client TLS certificate PEM path"
    },
    {
      "type": "ValidationTextBox",
      "name": "ClientKeyPath",
      "caption": "Private TLS client key path; file contents are never imported/exported"
    },
    {
      "type": "ValidationTextBox",
      "name": "AnchorCAFile",
      "caption": "Anchor TLS CA PEM path"
    },
    {
      "type": "ValidationTextBox",
      "name": "HardwareRootsDirectory",
      "caption": "Reviewed hardware attestation roots directory (.pem)"
    },
    {
      "type": "ValidationTextBox",
      "name": "HardwareAAGUIDs",
      "caption": "Reviewed hardware AAGUIDs as JSON array (32 lowercase hex each)"
    },
    {
      "type": "ValidationTextBox",
      "name": "HardwareTrustVersion",
      "caption": "Hardware trust-profile revision"
    }
  ],
  "actions": [
    {
      "type": "ExpansionPanel",
      "caption": "1. Authorize the storage wizard (credential lives for ten minutes)",
      "items": [
        {
          "type": "Label",
          "caption": "Apply settings first. Use this console-only credential in the HTML wizard to review and create vault and key storage. It is consumed before file creation and never saved in properties, exports or Debug."
        },
        {
          "type": "Button",
          "caption": "Issue one-use setup credential",
          "onClick": "SECB_BeginStorageSetup($id);"
        },
        {
          "type": "ValidationTextBox",
          "name": "SetupCredential",
          "caption": "Temporary setup credential (copy once; do not save)",
          "enabled": false
        },
        {
          "type": "Button",
          "caption": "Cancel setup credential",
          "onClick": "SECB_CancelStorageSetup($id);"
        }
      ]
    },
    {
      "type": "Button",
      "caption": "2. Recover / check independent anchor",
      "onClick": "SECB_Recover($id);"
    },
    {
      "type": "ExpansionPanel",
      "caption": "3. Independent administrator enrollment / recovery",
      "items": [
        {
          "type": "ValidationTextBox",
          "name": "AdminLabel",
          "caption": "Administrator/key label"
        },
        {
          "type": "CheckBox",
          "name": "HardwareEnrollment",
          "caption": "Require verified hardware attestation for this new credential"
        },
        {
          "type": "Button",
          "caption": "Issue temporary enrollment credential",
          "onClick": "SECB_BeginAdminEnrollment($id, $AdminLabel, $HardwareEnrollment);"
        },
        {
          "type": "ValidationTextBox",
          "name": "EnrollmentCredential",
          "caption": "Temporary enrollment credential (not configuration)",
          "enabled": false
        },
        {
          "type": "Label",
          "caption": "Use the enrollment credential in the HTML page. This is the independent console recovery path, not an ordinary web approver-enrollment bypass."
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Configuration export / import (no vault, keys or sessions)",
      "items": [
        {
          "type": "Button",
          "caption": "Export configuration",
          "onClick": "SECB_ExportConfiguration($id);"
        },
        {
          "type": "ValidationTextBox",
          "name": "ExportJSON",
          "caption": "Configuration export",
          "multiline": true
        },
        {
          "type": "ValidationTextBox",
          "name": "ImportJSON",
          "caption": "Configuration to import",
          "multiline": true
        },
        {
          "type": "Button",
          "caption": "Import configuration \u2014 leave disabled",
          "onClick": "SECB_ImportConfiguration($id, $ImportJSON);"
        }
      ]
    },
    {
      "type": "Button",
      "caption": "Clear Debug",
      "onClick": "SECB_ClearDebug($id);"
    }
  ],
  "status": [
    {
      "code": 102,
      "icon": "active",
      "caption": "Development backend active; acceptance review pending"
    },
    {
      "code": 104,
      "icon": "inactive",
      "caption": "Disabled"
    },
    {
      "code": 200,
      "icon": "error",
      "caption": "Backend locked; check storage, SQLite and anchor"
    }
  ]
}
